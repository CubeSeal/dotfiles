{
  "layer": "top",
  "modules-left": [
    "hyprland/workspaces",
    "custom/launcher",
    "custom/reboot",
    "custom/power"
  ],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "network",
    "clock"
  ],
  "custom/launcher": {
  "format": "<span color='#A3D4D5'> 󱓞 </span>",
  "on-click": "walker",
  "tooltip": true,
  "tooltip-format": "Walker"
  },
  "custom/reboot": {
    "format": "<span color='#DCA561'>  </span>",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/power": {
    "format": "<span color='#E82424'>  </span>",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Poweroff" 
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}: {windows}",
    "window-rewrite-default": "",
    "window-rewrite": {
      "title<.*youtube.*>": "", // Windows whose titles contain "youtube"
      "class<firefox> title<.*netflix.*>": "󰝆", // Windows whose class is "firefox" and title contains "github". Note that "class" always comes first.
      "class<firefox>": "", // Windows whose classes are "firefox"
      "kitty": "", // Windows that contain "foot" in either class or title. For optimization reasons, it will only match against a title if at least one other window explicitly matches against a title.
      "code": "󰨞"
    }
  },
  "hyprland/window": {
    "max-length": 50
  },
  "network": {
    "format-wifi": "<span color='#00FFFF'> 󰤨 </span>{essid} ",
    "format-ethernet": "<span color = '#6A9589'>  </span>{ipaddr}",
    "tooltip-format": "<span color='#D27E99'> 󰅧 </span>{bandwidthUpBits} <span color='#7E9CD8'> 󰅢  </span>{bandwidthDownBits}",
    "format-linked": "<span color='#FFA500'> 󱘖 </span>{ifname} (No IP) ",
    "format-disconnected": "<span color='#FF4040'>  </span>Disconnected ",
    "format-alt": "<span color='#00FFFF'> 󰤨 </span>{signalStrength}% ",
    "interval": 10,
    "family": "ipv4"
  },
  "clock": {
    "format": " {:%A | %d %B | %I:%M %p} ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%a, %d. %b  %H:%M}"
  }
}
