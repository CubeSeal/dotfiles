// vim: set tabstop=2 shiftwidth=2 expandtab:
{
  "layer": "top",
  "modules-left": [
    "hyprland/workspaces",
    "niri/workspaces",
    "custom/launcher",
    "custom/reboot",
    "custom/power"
  ],
  "modules-center": [ "hyprland/window", "niri/window" ],
  "modules-right": [
    "battery",
    "wireplumber",
    "bluetooth",
    "network",
    "clock"
  ],
  "custom/launcher": {
  "format": "<span color='#A3D4D5'> 󱓞 </span>",
  "on-click": "walker -s 'kanagawa'",
  "tooltip": true,
  "tooltip-format": "Walker"
  },
  "custom/reboot": {
    "format": "<span color='#DCA561'>  </span>",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/power": {
    "format": "<span color='#E82424'>  </span>",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Poweroff" 
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}: {windows}",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox> title<.*YouTube.*>": "", // Windows whose titles contain "youtube"
      "class<firefox> title<.*Netflix.*>": "󰝆", // Windows whose class is "firefox" and title contains "github". Note that "class" always comes first.
      "class<firefox>": "", // Windows whose classes are "firefox"
      "kitty": "", // Windows that contain "foot" in either class or title. For optimization reasons, it will only match against a title if at least one other window explicitly matches against a title.
      "code": "󰨞"
    }
  },
  "niri/workspaces": {
    "format": "{value} {icon}",
    "format-icons": {
      // Icons by state
      "active": "",
      "default": ""
    }
  },
  "hyprland/window": {
    "max-length": 50
  },
  "niri/window": {
    "icon": true,
    "icon-size": 18,
    "max-length": 50
  },
  "battery": {
    "format": " <span color='#76946A'>{icon}</span> {capacity}% ",
    "format-icons": ["󱊡", "󱊢", "󱊣"],
    "format-charging": " <span color='#76946A'>󰂄</span> {capacity}% " 
  },
  "wireplumber": {
      "format": " <span color='#DCA561'>{icon}</span> {volume}% ",
      "format-muted": "<span color='#E82424'></span> Muted ",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "format-icons": ["", "", ""],
      "scroll-step": 5
  },
  "bluetooth": {
  "on-click": "overskride",
	"format": " <span color='#7FB4CA'></span> ",
	"format-connected": " <span color='#7FB4CA'> </span>{device_alias} ",
	"format-connected-battery": " <span color='#7FB4CA'> </span>{device_battery_percentage}%",
	"tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%"
  },
  "network": {
    "format-wifi": " <span color='#C5C9C5'>󰤨</span> ",
    "format-ethernet": " <span color = '#6A9589'> </span> ",
    "tooltip-format": "<span color='#D27E99'> 󰅧 </span>{bandwidthUpBits}\n<span color='#7E9CD8'> 󰅢 </span>{bandwidthDownBits}",
    "tooltip-format-wifi": "<span color='#C5C9C5'>󰤨 {essid}</span>\n<span color='#D27E99'> 󰅧 </span>{bandwidthUpBits}\n<span color='#7E9CD8'> 󰅢 </span>{bandwidthDownBits}\n<span color='#FF9E3B'> 󰩟 </span>{ipaddr} ",
    "tooltip-format-ethernet": "<span color='#D27E99'> 󰅧 </span>{bandwidthUpBits}\n<span color='#7E9CD8'> 󰅢 </span>{bandwidthDownBits}\n<span color='#FF9E3B'> 󰩟 </span>{ipaddr} ",
    "format-linked": "<span color='#FFA500'> 󱘖 </span>{ifname} (No IP) ",
    "format-disconnected": "<span color='#FF4040'>  </span>Disconnected ",
    "format-alt": " <span color='#7FB4CA'> 󰒋 </span>{gwaddr} ",
    "interval": 10,
    "family": "ipv4"
  },
  "clock": {
    "format": " {:%y-%m-%d-%I-%M} ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%a, %d. %b  %H:%M}"
  }
}
